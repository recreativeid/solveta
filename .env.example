# ==========================================
# SOLVETA DATABASE CONFIGURATION (MySQL)
# ==========================================

# Host database (e.g. localhost, 127.0.0.1, or cloud host)
MYSQL_HOST=localhost

# Port default MySQL
MYSQL_PORT=3306

# Database user (e.g. root)
MYSQL_USER=root

# Database password (kosongkan jika tanpa password di XAMPP)
MYSQL_PASSWORD=

# Nama database yang dibuat dari schema.sql
MYSQL_DATABASE=solveta_db

# Set true jika menggunakan cloud MySQL dengan SSL (PlanetScale, Aiven, dll)
MYSQL_SSL=false
